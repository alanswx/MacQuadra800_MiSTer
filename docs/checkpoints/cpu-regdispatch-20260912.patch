+                                                  : {27'd0, alu_src[4:0]}) :
+                    p_sextw      ? {{16{alu_src[15]}}, alu_src[15:0]} : alu_src;
+wire [31:0] alu_b = (state == S_SHIFT) ? sh_val : alu_dst;
