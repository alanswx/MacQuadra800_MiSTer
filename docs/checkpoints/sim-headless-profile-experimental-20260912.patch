+	assert(c.step(false, true, command) && command.kind == SimControlCommand::Wait);
+	assert(!c.step(false, true, command));
+	assert(!c.step(true, true, command)); // paused clocks do not consume wait
+	assert(!c.step(false, true, command));
+	assert(!c.step(false, true, command));
