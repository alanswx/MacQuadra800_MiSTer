# 2026-09-19 04:40 build 10 (7f69882: + increment 13, the one-clock posted store), seed 21 + the switch: MEETS TIMING on
# every clock -- 36,428 ALMs (87 %), clk_sys +1.145 (the best of the branch), HDMI +0.251, clk_ram +0.445, TNS 0;
# synthesis 55,999 ALUTs. rbf 28a7e6dc = scratch/pipeline_b10/, runs after build 9.
# 2026-09-18 06:17 (machine clock; the entries above ran a day ahead) build 12, the bisect (build tree edca43e = build 8 +
# increments 13, 14, 15, WITHOUT 11 and 12), seed 21 + the switch: MEETS TIMING on every clock -- 36,071 ALMs (86 %),
# clk_sys +1.241 (the best of the branch), HDMI +0.412, clk_ram +0.806, hold +0.198, TNS 0; synthesis 55,480 ALUTs;
# sdram_beat32 req_tgl -> req_handoff +1.384 (b10 +1.270, b8 +2.513). rbf 555a954b = scratch/pipeline_b12/. The flow ran
# under build 11's launcher, which had survived its stop in the wait-gate (the log is build_b11_s21r.log, copied to
# build_b12_s21r.log); the tree was clean at edca43e from 05:35, the flow started 05:54. Build 11 (the head) was never built.
# ON HARDWARE build 12 DOES NOT BOOT (bare grey screen, no pointer): increment 14's read-passes-store compared only the
# first 16-byte line, so a fill passed a queued line-crossing store (fixed cf06fe6; the full-machine sim reproduces the
# hang on build 12's tree and boots build 13's).
# 2026-09-18 06:55 build 13 (build 12's tree + cf06fe6; build tree 4d09389), seed 21 + the switch: MEETS TIMING on every
# clock -- 36,089 ALMs (86 %), clk_sys +0.772, HDMI +0.527, clk_ram +0.668, hold +0.204, TNS 0; req_tgl -> req_handoff
# +0.727 (b12 +1.384). rbf fde49a3c = scratch/pipeline_b13/. ON HARDWARE: boots, Mix 0.9285 (mean of 8; b8 0.907, shipped
# 0.855), CQD 0.670, 0 anomalous values in 11 series, clean shutdown. The branch head (11/12 reverted, 4abb118) = this RTL.
# 2026-09-18 14:31 ethernet build 1 (69d9585 on add-ethernet = build 13's machine + rtl/sonic_mbx.sv and its wiring; built
# on the second Quartus host, dani@192.168.99.153, same 17.0.2 Lite), seed 21 + the switch: 36,560 ALMs (87 %, +471;
# sonic_mbx itself 401.6 ALMs / 665 ALUTs / 0 RAM), clk_sys +0.547, clk_ram +0.770, hold +0.214, HDMI VIOLATED -0.306
# (TNS -0.504, the framework's video register again). rbf 815ee8b4 = scratch/eth/build1/, tried on hardware as a marginal
# build (the miss is not on the CPU clock). ON HARDWARE: Mac OS 8.1 boots with Ethernet Off and On, the driver opens, 12
# packets out, DMA round trips 36 us average -- then the whole guest FREEZES: iosb's VIA2 any-slot flag followed edges of
# the OR of VBL and SONIC and lost the interrupt for good (fixed 665a450). The seed 22 fit of this tree was abandoned.
# 2026-09-18 15:33 ethernet build 2 (665a450: + the any-slot flag as a level, + the front-end's DEBUG word), seed 21 + the
# switch, on .153: MEETS TIMING on every clock -- 36,502 ALMs (87 %), clk_sys +0.323, HDMI +0.314, clk_ram +0.716, hold
# +0.220, TNS 0. rbf 2ea4d529 = scratch/eth/build2/.
# 2026-09-19 XSTORE c328ae7, seed 21: 36,871 ALMs (88%), 491 RAM blocks,
# 43 DSP; setup +0.068 ns, hold +0.243 ns, CPU +0.979 ns, SDRAM +0.800 ns.
# Crossings sys->ram +1.514 ns / ram->sys +0.979 ns. Hardware Mix pending.
# 2026-09-19 XSTORE+LEA 94d922f, seed21: 36,997 ALMs88%,491RAM,43DSP.
# Setup +0.311 ns, hold +0.238 ns; CPU +1.025 ns, SDRAM +0.555 ns.
# Crossings sys->ram +0.555 ns / ram->sys +1.025 ns; hardware trial pending.
# 2026-09-19 P4 pipeline PEA 6e852a6, seed21: 38,185 ALMs91%,491RAM,43DSP.
# CPU setup -0.357 ns (timing-marginal trial only), HDMI +0.180, hold +0.223.
# SDRAM +0.478 ns; crossings sys->ram +0.478 / ram->sys +0.843 ns.
# Cache data/tag RAM inference preserved. RBF SHA256 25c41c76545eb38b767df72145080d19b37577862816fcbb7250f864950ec2be.
# 2026-09-19 P5 overlap + separate RF reads e12d882, seed21:38,320ALMs91%,491RAM,43DSP.
# CPU +0.532 ns (internal CPU paths +0.556); SDRAM +0.665; hold +0.202.
# HDMI -0.091 ns (shadowmask->OSD), second path -0.008 (scaler); experimental trial.
# Crossings sys->ram +1.016 / ram->sys +0.532 ns. Both added RF banks remain MLAB.
# RBF SHA256 4449b3c51a3e991515afe0440ce2da5aeab2d6175fbcda210f344d8841f037b1.
# 2026-09-19 P6 indexed MOVE/shifts/LEA d83e238, seed21:39,631ALMs95%,491RAM,43DSP.
# All timing met: CPU +0.252 ns, HDMI +0.089, SDRAM +0.741, hold +0.241.
# Crossings sys->ram +0.741 / ram->sys +0.914 ns. RF bankE512bitMLAB; cache RAM preserved.
# RBF SHA256 67a88e021a00722fed025cb261eb766ef3cb3f22c9c6200d77cb529fba935af0.
# 2026-09-19 P6 memory-entry 90b37e4, seed21:39,603ALMs94%,491RAM,43DSP.
# CPU +0.904 ns, SDRAM +0.608, hold +0.208; HDMI -0.187 ns (trial only).
# Crossings sys->ram +0.608 / ram->sys +0.904 ns. Source and extraction checks pass.
# RBF SHA256 d35e6b42edb653aab94cb95f6a5a92eefea8d8cf9b640d679a5b7055ca95df68.
# 2026-09-19 P7 compare+early-drain 1c04a43, seed21:39,559ALMs94%,491RAM,43DSP.
# CPU -0.012 ns (experimental only), HDMI +0.308, SDRAM +0.424, hold +0.220.
# Crossings sys->ram +0.462 / ram->sys +0.790 ns. Source/extraction checks pass.
# RF bankE512bitMLAB and cache tags M10K preserved; 26,405 registers.
# RBF SHA256 702e23482a2203befc88b190446b68bfe182ef37a4c848057a866875305d9700.
# 2026-09-19 P7 admission/branch f2b2770, seed21:39,591ALMs94%,491RAM,43DSP.
# CPU -0.862 ns (TNS -4.710), HDMI -0.069 (TNS -0.394), SDRAM +0.727, hold +0.201.
# Crossings sys->ram +0.771 / ram->sys +0.611; RF bankE MLAB, cache tags M10K.
# Worst CPU path regfile pend_we -> general ALU -> pc[22], 27 logic levels.
# Experimental trial only. Source/archive/cross checks pass; 26,347 registers.
# RBF SHA256 e12627b49d97fd2efd41433c058e1c28906c7959317a63c52544cd655b26759e.
# 2026-09-19 P13 cross-line cache admission (ef4f71d): timing met,
# 39,772 ALMs; CPU +0.757, HDMI +0.135, SDRAM +0.200 ns;
# worst hold +0.238, sys->ram +0.200 and ram->sys +0.757 ns.
set_global_assignment -name SEED 21
set_global_assignment -name FITTER_AGGRESSIVE_ROUTABILITY_OPTIMIZATION ALWAYS
#
# 2026-09-08: the release recipe.  Alan's 5aa596f AP68040 is +20 % logic and
# the design no longer fits with speed-directed synthesis; all-area
# synthesis fits but breaks HDMI-domain timing.  What fits with timing
# (build L, MacQuadra800_20260908_2, +0.171 ns): OPTIMIZATION_MODE BALANCED,
# OPTIMIZATION_TECHNIQUE BALANCED, register duplication off, plus the
# switches below -- CACHE_CD_OFF (the CD passes through the block cache),
# CACHE_SMALL (32/32/16-sector cache), MISTER_DISABLE_ALSA (Linux-side audio
# mix; MT32-pi is a separate module), MISTER_DOWNSCALE_NN and
# MISTER_DISABLE_ADAPTIVE (scaler refinements).  Composite Y/C stays in.
# Re-enable any of them only with a matching cut elsewhere
# (docs: area-levers in the resume doc; releases/README.md).

#set_global_assignment -name VERILOG_MACRO "MISTER_FB=1"

#enable it only if 8bit indexed mode is used in core
#set_global_assignment -name VERILOG_MACRO "MISTER_FB_PALETTE=1"

#do not enable DEBUG_NOHDMI in release!
#set_global_assignment -name VERILOG_MACRO "MISTER_DEBUG_NOHDMI=1"

# disable bilinear filtering when downscaling
set_global_assignment -name VERILOG_MACRO "MISTER_DOWNSCALE_NN=1"

# disable adaptive scanline filtering
set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_ADAPTIVE=1"

# ============================================================================
# DEBUG ONLY -- SCSI protocol tracer in rtl/iosb.sv.
#
# Uncomment to stream every first-sighting SCSI register value, bus fault and
# stray I/O address out the modem port as ASCII, readable on the MiSTer with
#     stty -F /dev/ttyS1 115200 raw -echo && cat /dev/ttyS1
# (scripts/scsi_trace.sh does deploy + capture + decode in one go).
#
# This TAKES OVER the guest's serial port -- the SCC no longer reaches the pin.
# Never ship a bitstream built with this on.  scripts/build_only.sh detects the
# line below and prints a DEBUG BUILD banner so it cannot pass unnoticed.
# ============================================================================
#set_global_assignment -name VERILOG_MACRO "SCSI_TRACE=1"
#set_global_assignment -name VERILOG_MACRO "CDROM_OFF=1"
#set_global_assignment -name VERILOG_MACRO "ETHERNET_OFF=1"
# Posted cross-line cache-store merge, validated on hardware.
set_global_assignment -name VERILOG_MACRO "AP040_EXPERIMENTAL_XSTORE=1"
# Overlap LEA displacement fetch with base selection; checked independently.
set_global_assignment -name VERILOG_MACRO "AP040_EXPERIMENTAL_LEA=1"
# P6 candidate: broaden the resident integer/memory stream at authentic 33 MHz.
set_global_assignment -name VERILOG_MACRO "AP040_EXPERIMENTAL_PIPELINE=1"
set_global_assignment -name VERILOG_MACRO "AP040_EXPERIMENTAL_PIPELINE_LOADS=1"
set_global_assignment -name VERILOG_MACRO "AP040_EXPERIMENTAL_PIPELINE_STORES=1"
set_global_assignment -name VERILOG_MACRO "AP040_EXPERIMENTAL_PIPELINE_PEA=1"
# P6 memory-entry trial: avoid unrestricted entry's measured Mix regression.
set_global_assignment -name VERILOG_MACRO "AP040_EXPERIMENTAL_PIPELINE_P6=1"
set_global_assignment -name VERILOG_MACRO "AP040_PIPELINE_MEMORY_ENTRY=1"
# P7 compare trial: indexed CMP/TST plus final-WB legacy handoff.
set_global_assignment -name VERILOG_MACRO "AP040_PIPELINE_COMPARE=1"
set_global_assignment -name VERILOG_MACRO "AP040_PIPELINE_EARLY_DRAIN=1"
set_global_assignment -name VERILOG_MACRO "CACHE_CD_OFF=1"
#set_global_assignment -name VERILOG_MACRO "VIDEO_512_OFF=1"
set_global_assignment -name VERILOG_MACRO "CACHE_SMALL=1"

#use only 1MB per frame for scaler to free ~21MB DDR3 RAM
#set_global_assignment -name VERILOG_MACRO "MISTER_SMALL_VBUF=1"

# Disable YC / Composite output to save some resources
#set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_YC=1"

# Disable ALSA audio output to save some resources
set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_ALSA=1"

source sys/sys.tcl
source sys/sys_analog.tcl
source files.qip
